  "activityCapture": "Activity capture",
  "captureConsentBody": "KangoOS can record the app and window title you have focused, to build a timeline of your work.",
  "captureConsentPrivacy": "Captured data stays on this device by default. Sending activity to a remote model for automatic summaries requires a separate opt-in in capture settings.",
  "launchAtStartup": "Launch KangoOS at startup",
  "launchAtStartupDescription": "Starts KangoOS minimized to the tray when you sign in, so capture runs without opening the window.",
  "captureActiveWindow": "Capture active window",
  "captureActiveWindowDescription": "Records the app and window title every few seconds while KangoOS is open.",
  "captureBrowserUrls": "Capture browser URLs",
  "captureBrowserUrlsDescription": "Also records the active tab's URL for Chrome/Edge/Brave/Safari. This is content, not just metadata: off by default. On Windows/Linux this reads the address bar via accessibility APIs (best-effort, may not always work); on macOS it requires granting Accessibility permission to KangoOS.",
  "captureVisibleText": "Capture visible text (experimental)",
  "captureVisibleTextDescription": "Also records the text you were focused on (e.g. what a text field contains), via Windows UI Automation. Runs in a separate helper process so a crash there never affects KangoOS, but it means this may silently capture nothing on some systems.",
  "captureClipboard": "Capture clipboard",
  "captureClipboardDescription": "Also records whatever you copy. This is the most sensitive capture source. Common credential patterns are redacted before storage, but filtering is not exhaustive. Off by default; excluded apps are still skipped, but the clipboard can outlive the app you copied it from.",
  "allowRemoteSummaries": "Allow remote automatic summaries",
  "allowRemoteSummariesDescription": "Sends captured activity to the configured remote LLM every 20 minutes. Off by default. Loopback Ollama remains local and does not require this permission.",
  "redactCapturedPii": "Redact personal data",
  "redactCapturedPiiDescription": "Best-effort redaction of email addresses, Brazilian phone and CPF numbers, and payment-card patterns before capture is stored. Off by default.",
